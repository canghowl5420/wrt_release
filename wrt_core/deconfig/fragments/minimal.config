# =============================================================================
# minimal.config —— 精简片段（放到 fork 的 wrt_core/deconfig/fragments/minimal.config）
# 用法：Actions 运行时 add_fragments=minimal, remove_fragments=docker_deps,proxy
# =============================================================================

# 代理 / 容器 / 商店
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-istorex=n
CONFIG_PACKAGE_luci-app-store=n

# 网络服务类重插件
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-pbr=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_easytier=n
CONFIG_PACKAGE_luci-app-easytier=n

# 存储 / 打印 / 内网分享
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-cupsd=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-quickfile=n
CONFIG_PACKAGE_luci-app-diskman=y

# 小工具
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_coremark=n

# ===== 保底：基础件绝不裁（防止没 Web / 没主题 / luci-light 被丢）=====
# luci-light 是“主题 + uhttpd + admin + firewall + proto-ppp”的载体，必须直接选上
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_dnsmasq-full=y
# LuCI 的 ucode 运行时模块（luci-base 依赖，缺了会报 No module named 'xxx'）
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-html=y
